(executable
 (name main)
 (modes js)
 (libraries pgn_to_tex js_of_ocaml yojson)
 (preprocess
  (pps js_of_ocaml-ppx))
 (enabled_if
  (= %{env:CI=false} "false")))

(rule
 (enabled_if
  (= %{env:CI=false} "false"))
 (targets pgn_to_tex.cjs)
 (action
  (copy main.bc.js %{targets})))

(rule
 (enabled_if
  (= %{env:CI=false} "false"))
 (alias build-cjs)
 (action
  (diff? pgn_to_tex.cjs %{workspace_root}/pgn_to_tex.cjs)))
